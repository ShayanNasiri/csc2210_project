# Environment
.venv/
__pycache__/
*.pyc

# Data (too large for git — regenerated via download_data.py)
data/*.parquet
data/*.pt

# Results: CSVs / JSONs / logs are kept in-repo for reviewer audit.
# Weights (.pt, regenerable from training scripts) are excluded — too
# large for git. Plots (.png / .jpg / .pdf / .svg) are also excluded
# until the final review pass — they will be added later.
results/**/*.pt
results/**/*.png
results/**/*.jpg
results/**/*.jpeg
results/**/*.pdf
results/**/*.svg

# Nsight reports
*.ncu-rep

# Build artifacts
*.egg-info/

# Testing
.pytest_cache/

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db
