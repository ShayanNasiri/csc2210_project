# Environment
.venv/
__pycache__/
*.pyc

# Data (too large for git — regenerated via download_data.py)
data/*.parquet
data/*.pt

# Results: CSVs and JSONs are kept in-repo for reviewer audit.
# Logs, weights (.pt, regenerable from training scripts), and plots
# are excluded — large and/or not needed for reproducibility.
results/**/*.log
results/**/*.pt
results/**/*.png
results/**/*.jpg
results/**/*.jpeg
results/**/*.pdf
results/**/*.svg

# Nsight reports
*.ncu-rep

# Build artifacts
*.egg-info/

# Testing
.pytest_cache/

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db
